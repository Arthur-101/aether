{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aether",
  "mainBinaryName": "Aether",
  "version": "0.1.2",
  "identifier": "com.aether.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aether",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Aether",
    "copyright": "Copyright © 2026 Aether Contributors",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../../dist/aether-backend": "aether-backend"
    },
    "category": "Utility",
    "shortDescription": "Local-first Windows AI desktop assistant.",
    "longDescription": "Aether is a local-first Windows AI desktop assistant with voice control, screen-region questions, file tools, and a top-anchored desktop island.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Arthur-101/aether/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFRUIyQkU0OTI2QTg4QzgKUldUSWlHcVM1Q3ZyRGlSd2hpZnZ5cXA5dXozL05PL0ppVDV1SnkxWTA4RnpULzVYQ3ZoeUdEYkkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
